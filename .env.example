# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 数据加密配置
ENCRYPTION_KEY=your-super-secret-encryption-key-change-this-in-production-min-32-chars

# 数据库配置
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/exam_system
SPRING_DATASOURCE_USERNAME=exam_user
SPRING_DATASOURCE_PASSWORD=exam_password

# Redis配置
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# 应用配置
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production

# 日志配置
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SPEC_KIT_EXAM_SYSTEM=DEBUG

# 监控配置
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true